# Copy this file to .env and fill in your real values.
# .env is git-ignored -- it will never be committed.

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_platform
DB_USER=postgres
DB_PASSWORD=changeme

# ---- Spark ----
SPARK_APP_NAME=BankingDataPlatform
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g
SPARK_JDBC_JAR=jars/postgresql-42.7.3.jar
